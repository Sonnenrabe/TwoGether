            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="August 2026"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="❮"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_today"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:text="Today"
            android:textColor="@color/couple_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="❯"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_add"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="＋"
            android:textColor="@color/couple_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

