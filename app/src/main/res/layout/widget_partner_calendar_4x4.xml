        </LinearLayout>

    </LinearLayout>

    <!-- Subtle Divider -->
    <ImageView
        android:id="@+id/widget_divider_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:background="@color/widget_divider"
        android:contentDescription="" />

    <!-- Bottom Half: Selected Day Overview & Scrollable List (50% of available height on 4x6) -->
    <LinearLayout
        android:id="@+id/widget_day_overview_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Selected Date Header Row with Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_selected_date_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="📅 Heute, 19. Aug"
                android:textColor="@color/widget_text_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_selected_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_button_bg"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="0 Termine"
                android:textColor="@color/couple_together"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <!-- Dedicated button to add appointment for the currently selected date -->
            <TextView
                android:id="@+id/widget_btn_add_selected_day"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_button_bg"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="＋ Termin"
                android:textColor="@color/couple_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty state placeholder -->
        <TextView
            android:id="@+id/widget_empty_state_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/widget_empty_state_bg"
            android:gravity="center"
            android:padding="8dp"
            android:text="Keine Termine für diesen Tag ☕"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Scrollable Appointment ListView -->
        <ListView
            android:id="@+id/widget_appointment_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            android:scrollbars="vertical" />

    </LinearLayout>

</LinearLayout>
