                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="7">
                <LinearLayout android:id="@+id/widget_day_cell_35" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_day_num_35" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:text="5" /><TextView android:id="@+id/widget_day_dots_35" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="6sp" android:includeFontPadding="false" /></LinearLayout>
                <LinearLayout android:id="@+id/widget_day_cell_36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_day_num_36" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:text="6" /><TextView android:id="@+id/widget_day_dots_36" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="6sp" android:includeFontPadding="false" /></LinearLayout>
                <LinearLayout android:id="@+id/widget_day_cell_37" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_day_num_37" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:text="7" /><TextView android:id="@+id/widget_day_dots_37" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="6sp" android:includeFontPadding="false" /></LinearLayout>
                <LinearLayout android:id="@+id/widget_day_cell_38" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_day_num_38" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:text="8" /><TextView android:id="@+id/widget_day_dots_38" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="6sp" android:includeFontPadding="false" /></LinearLayout>
                <LinearLayout android:id="@+id/widget_day_cell_39" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_day_num_39" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:text="9" /><TextView android:id="@+id/widget_day_dots_39" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="6sp" android:includeFontPadding="false" /></LinearLayout>
                <LinearLayout android:id="@+id/widget_day_cell_40" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_day_num_40" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:text="10" /><TextView android:id="@+id/widget_day_dots_40" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="6sp" android:includeFontPadding="false" /></LinearLayout>
